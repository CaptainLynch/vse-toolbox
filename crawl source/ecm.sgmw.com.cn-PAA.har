d><_est_cmpl_date is_null=\"1\" /><_est_cost>N/A</_est_cost><_ewo_no>EWO-045335</_ewo_no><_exted_reason>N/A</_exted_reason><_gacsn>N/A</_gacsn><_idle_days>3</_idle_days><_issue_date is_null=\"1\" /><_key_part>1</_key_part><_license_tag>0</_license_tag><_mass_impact>0</_mass_impact><_model_year>2025</_model_year><_mtl_rq_date>2026-06-12T00:00:00</_mtl_rq_date><_pe_tdc keyed_name=\"朱彦桥(z22400239)\" type=\"User\">A6F701373A6D44FE9183BFE06289FF7A</_pe_tdc><_pe_tdc_department>技术中心_能源驱动</_pe_tdc_department><_pe_tdc_name>朱彦桥(z22400239)</_pe_tdc_name><_pe_tdc_phone>15736196015</_pe_tdc_phone><_pe_tdc_smt>ES2 能源科</_pe_tdc_smt><_pp_comments>N/A</_pp_comments><_project_type>1</_project_type><_quantity>1440</_quantity><_reason>1、因国标GB44263-2024更新，以及2015+快充新国标技术路线的成熟，BMS需进行更新迭代，升级为最终版BMS 3.0PRO。新项目在2025年8月前完成断点，在产项目在2026年8月前完成断点，断点完成后BMS 3.0PRO成为唯一平台，保证规模化。\r\n2、旧快充国标最大充电电流限制为250A，而2015+快充新国标将最大充电电流限制放宽至800A。采用2015+快充新国标技术路线进行迭代后可在市面上匹配更多快充桩的满功率充电。\r\n\r\n1、N350V-41.9kWh\r\n动力蓄电池系统总成零件号：27240131\r\nBMS零件号：27204318  软件版本号：350VE0700LA0740003\r\n2、F510C 54.5kWh\r\n动力蓄电池系统总成零件号：27238813\r\nBMS零件号：27238814 软件版本号：510C00700LA1720001\r\n3、F411S 56.7kWh \r\n动力蓄电池系统总成零件号：27238034\r\nBMS零件号：27238283 软件版本号：410S00700LA1340001\r\nBMS零件号：27238846 软件版本号：410S00700LA1440001\r\n4、F520S 56.7kwh\r\n动力蓄电池系统总成零件号：27238825\r\nBMS零件号：27238826  软件版本号：F520S0700LA0640001\r\nBMS零件号：27238854  软件版本号：F520S0700LA0740001\r\n5、F520M&amp;F520S 54.5kWh\r\n动力蓄电池系统总成零件号：27238829\r\nBMS零件号：27238830  软件版本号：F520M0700LA1340001\r\n6、F520M 60kWh\r\n动力蓄电池系统总成零件号：27238833\r\nBMS零件号：27238834 软件版本号：F520M0700LA1440001\r\n7、F520M&amp;F520S 20.5kwh\r\n动力蓄电池系统总成零件号：27227655\r\nBMS零件号：27227656 软件版本号：F520M0700LA1240001\r\nBMS零件号：27238636 软件版本号：F520M0700LA1540001\r\n8、F520M 20.5kwh\r\n动力蓄电池系统总成零件号：27238638\r\nBMS零件号：27238639 软件版本号：F520M0700LA1640001\r\n9、E261MCE 31.9kwh\r\n动力蓄电池系统总成零件号：27188184\r\nBMS零件号：27201481 软件版本号：E260SP700LA1740001\r\nBMS零件号：27239912 软件版本号：E260M0700LA2020001\r\nBMS零件号：27239914 软件版本号：E260M0700LA2120001\r\n10、E261MCE 41.9kwh\r\n动力蓄电池系统总成零件号：27238333\r\nBMS零件号：27238334 软件版本号：E260M0700LA1940001\r\n11、E110C 16.2kwh\r\n动力蓄电池系统总成零件号：27239420\r\nBMS零件号：27197391 软件版本号：E112C0700LA0140002\r\n12、E110C 16.2kwh\r\n动力蓄电池系统总成零件号：27239423\r\nBMS零件号：27197394 软件版本号：E112C0700LA0240002\r\n\r\n因PPAP未完成，需要发布PAA支持PTR验证及断点</_reason><_requester_department>技术中心_能源驱动</_requester_department><_requester_phone>15736196015</_requester_phone><_requester_smt>ES2 能源科</_requester_smt><_resp_unit>N/A</_resp_unit><_rework_place>N/A</_rework_place><_spcl_instr>N/A</_spcl_instr><_stakeholder_buy_in>N/A</_stakeholder_buy_in><_stock_disp>1</_stock_disp><_submit_date>2026-06-12T16:51:39</_submit_date><_support_ewo_concession>1</_support_ewo_concession><_validation_statement>N/A</_validation_statement><_vehicles>E110C,E260 MCE,F510C,F520S,F520M,F410S,N350V_EV</_vehicles><created_by_id keyed_name=\"朱彦桥(z22400239)\" type=\"User\">A6F701373A6D44FE9183BFE06289FF7A</created_by_id><created_on>2026-06-10T10:46:40</created_on><css is_null=\"1\" /><current_state name=\"EDIT\" keyed_name=\"EDIT\" type=\"Life Cycle State\">9EB52C13DF7B45E293D56BFC03138165</current_state><effective_date is_null=\"1\" /><generation>1</generation><id keyed_name=\"PAA011515\" type=\"PAA_O\">2D4ABB75435A4C19A15846B551597A96</id><is_current>1</is_current><keyed_name>PAA011515</keyed_name><locked_by_id is_null=\"1\" /><major_rev>A</major_rev><modified_by_id keyed_name=\"卢晨(l21220034)\" type=\"User\">79DA57AD0FA24356ACA7F649AECA726A</modified_by_id><modified_on>2026-06-18T09:59:32</modified_on><new_version>1</new_version><release_date is_null=\"1\" /><state>EDIT</state><_no>PAA011515</_no></Item><Item type=\"PAA_O\" typeId=\"AB78E8D480754234925C19962AD62A4D\" id=\"B620CBB714B942EEA17D5EE26D2EA7D0\" page=\"1\"><_affect_certificate>0</_affect_certificate><_affect_vehicle_photo>0</_affect_vehicle_photo><_area>BJ-GA-00</_area><_auth_type>1</_auth_type><_base>BJ</_base><_change_description>不涉及公告参数</_change_description><_charge_to>N/A</_charge_to><_days>60