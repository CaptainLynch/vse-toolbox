（EWO-046847）；\r\n4、根据项目采购定点策略，N001高顶左后侧围内板焊合件采用EWO定点，基础车型N001中顶车（EWO-045410）。\r\n</_reason><_requester_department>技术中心_车体工程</_requester_department><_requester_phone>2652103</_requester_phone><_requester_smt>SES 结构工程科</_requester_smt><_resp_unit>N/A</_resp_unit><_rework_place>N/A</_rework_place><_spcl_instr>N/A</_spcl_instr><_stakeholder_buy_in>N/A</_stakeholder_buy_in><_stock_disp>1</_stock_disp><_submit_date>2026-06-16T09:25:52</_submit_date><_support_ewo_concession>1</_support_ewo_concession><_validation_statement>N/A</_validation_statement><_vehicles>N001,N001依维柯</_vehicles><created_by_id keyed_name=\"蒙文范(m20900085)\" type=\"User\">46033601884B440EB6A0EC216E34BCC0</created_by_id><created_on>2026-06-15T15:17:15</created_on><css is_null=\"1\" /><current_state name=\"DRAFT2\" keyed_name=\"DRAFT2\" type=\"Life Cycle State\">5CCF469CE65346BF946ED9935864505B</current_state><effective_date is_null=\"1\" /><generation>1</generation><id keyed_name=\"PAA011528\" type=\"PAA_O\">2A21D80B36B84C8DA754D82B6A5EDA87</id><is_current>1</is_current><keyed_name>PAA011528</keyed_name><locked_by_id is_null=\"1\" /><major_rev>A</major_rev><modified_by_id keyed_name=\"周云春(z22100041)\" type=\"User\">599C9F0CF6BC4BB98148BB18105EBF9B</modified_by_id><modified_on>2026-06-18T18:57:05</modified_on><new_version>1</new_version><release_date is_null=\"1\" /><state>DRAFT2</state><_no>PAA011528</_no></Item><Item type=\"PAA_O\" typeId=\"AB78E8D480754234925C19962AD62A4D\" id=\"E57B67A86815470F826380ABED26E0E2\" page=\"1\"><_affect_certificate>0</_affect_certificate><_affect_vehicle_photo>0</_affect_vehicle_photo><_area>BJ-GA-00</_area><_auth_type>1</_auth_type><_base>BJ</_base><_change_description>N/A</_change_description><_charge_to>N/A</_charge_to><_days>60</_days><_days_or_qty>0</_days_or_qty><_effect_consistency>0</_effect_consistency><_emis_related>0</_emis_related><_est_cmpl_date is_null=\"1\" /><_est_cost>N/A</_est_cost><_ewo_no></_ewo_no><_exted_reason>N/A</_exted_reason><_gacsn>N/A</_gacsn><